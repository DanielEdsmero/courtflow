# Test-only Supabase config. Loaded ONLY under `vite --mode test`. A mode-specific file outranks
# .env.local in Vite, so the e2e run never touches the real project.
# Nothing here is a credential: every request to this origin is intercepted by
# Playwright and answered from a fixture (see e2e/stub-supabase.js).
VITE_SUPABASE_URL=http://127.0.0.1:9999
VITE_SUPABASE_ANON_KEY=test-anon-key-never-sent-anywhere
